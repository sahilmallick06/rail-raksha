# ==============================================================================
# RailRaksha Control Centre — Environment Configuration Template
# Copy to .env for local development. NEVER commit real secrets.
# ==============================================================================

# Optional AI Assistant Provider (gemini | none)
# The core railway dashboard, simulator, ML inference, and Demo Mode operate
# completely without an LLM key.
LLM_PROVIDER="gemini"

# Server-side Gemini API key (configured via Settings > Secrets in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional RailRadar Third-Party Train Status API (read-only)
# When absent, RailRaksha serves timestamped cached/sample snapshots transparently.
RAILRADAR_API_KEY=""
RAILRADAR_API_BASE="https://railradar.in/api/v1"

# Conservative Local Provider Quota Safeguards (application-side limits)
RAILRADAR_MAX_CALLS_PER_DAY="12"
RAILRADAR_MAX_CALLS_PER_MONTH="240"
RAILRADAR_MAX_FLEET_REFRESH="3"
RAILRADAR_FRESH_CACHE_MINUTES="30"
RAILRADAR_STALE_CACHE_DAYS="7"

# Optional External Python FastAPI Backend URL (if running uvicorn backend.app:app locally)
FASTAPI_BASE_URL=""

# Hosting URL (injected automatically in AI Studio)
APP_URL="http://localhost:3000"
